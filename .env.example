# ═════════════════════════════════════════════════════════════
#  الگوی متغیرهای محیطی. این فایل به گیت می‌رود (بدون رمز واقعی).
#  برای شروع، از رویش کپی بگیر:  cp .env.example .env
# ═════════════════════════════════════════════════════════════

# ───────── حالت ۱) توسعه‌ی لوکال (Postgres روی همین سیستم) ─────────
# یک Postgres لوکال بساز و دیتابیس barber را ایجاد کن، سپس:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barber"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/barber"

# ───────── حالت ۲) پروداکشن (Supabase / Vercel) ─────────
# از داشبورد Supabase: Connect → ORMs → Prisma. به‌جای [YOUR-PASSWORD] رمز دیتابیس را بگذار.
# روی Vercel این مقادیر در Settings → Environment Variables ست می‌شوند (نه در این فایل).
# DATABASE_URL = اتصال Pooled پورت 6543 (زمان اجرا)
# DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = اتصال مستقیم پورت 5432 (برای migrate / db push)
# DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-REGION.pooler.supabase.com:5432/postgres"

# ───────── تنظیمات اپ ─────────
# رمز ورود به پنل مدیریت (صفحه‌ی /admin/login).
# 🔴 حتماً یک رمزِ قوی (حداقل ۸ کاراکتر) بگذار؛ رمزهای ضعیف/پیش‌فرض (مثل admin) رد می‌شوند.
ADMIN_PASSWORD=""

# کلید امضای کوکی سشن — یک رشته‌ی تصادفی بلند (حداقل ۳۲ کاراکتر).
# نمونه‌ی تولید:  openssl rand -base64 32
SESSION_SECRET="please-generate-a-long-random-secret-string"

# ───────── درگاه پرداخت زرین‌پال ─────────
# شناسه‌ی پذیرنده (Merchant ID) که از پنل زرین‌پال می‌گیری (فرمت UUID).
ZARINPAL_MERCHANT_ID=""
# تا قبل از دریافت مرچنت واقعی، روی حالت تستی (sandbox) بگذار: "true"
ZARINPAL_SANDBOX="true"
# توکن دسترسیِ استرداد (متفاوت با merchant_id). بدون آن، استرداد فقط «حسابداری» ثبت می‌شود.
ZARINPAL_ACCESS_TOKEN=""
# 🔴 اجازه‌ی «پرداختِ شبیه‌سازی‌شده» بدونِ درگاهِ واقعی. فقط برای توسعه/تست روی "true".
#    اگر MERCHANT_ID خالی باشد و این هم "true" نباشد، هر پرداخت با خطا رد می‌شود (امن).
#    روی پروداکشن هرگز "true" نگذار.
ALLOW_MOCK_PAYMENT="true"
# آدرس پایه‌ی سایت برای ساخت callback مطلق (روی Vercel آدرس دامنه‌ی پروداکشن).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ───────── سامانه‌ی پیامک (SMS/OTP) ─────────
# انتخابِ provider: console (فقط لاگ، توسعه) | kavenegar (نمونه‌ی آماده) | custom (قلابِ خودت)
SMS_PROVIDER="console"
# کلیدِ APIِ پنلِ پیامک (وقتی provider واقعی شد).
SMS_API_KEY=""
# شماره/خطِ ارسال (اگر پنل نیاز دارد).
SMS_SENDER=""
# نامِ قالب/الگوی OTP در پنل (پنل‌های ایرانی معمولاً برای کدِ تأیید «لوکاپ/الگو» دارند).
SMS_OTP_TEMPLATE=""

# ───────── کرون (پاک‌سازیِ رزروهای رهاشده) ─────────
# رشته‌ی تصادفیِ بلند. روی Vercel این را ست کن تا فقط خودِ Vercel Cron بتواند
# /api/cron/expire-pending را صدا بزند.  نمونه‌ی تولید:  openssl rand -base64 32
CRON_SECRET=""
