# ═════════════════════════════════════════════════════════════
#  الگوی متغیرهای محیطی. این فایل به گیت می‌رود (بدون رمز واقعی).
#  برای شروع، از رویش کپی بگیر:  cp .env.example .env
# ═════════════════════════════════════════════════════════════

# ───────── حالت ۱) توسعه‌ی لوکال (Postgres روی همین سیستم) ─────────
# یک Postgres لوکال بساز و دیتابیس barber را ایجاد کن، سپس:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barber"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/barber"

# ───────── حالت ۲) پروداکشن (Supabase / Vercel) ─────────
# از داشبورد Supabase: Connect → ORMs → Prisma. به‌جای [YOUR-PASSWORD] رمز دیتابیس را بگذار.
# روی Vercel این مقادیر در Settings → Environment Variables ست می‌شوند (نه در این فایل).
# DATABASE_URL = اتصال Pooled پورت 6543 (زمان اجرا)
# DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = اتصال مستقیم پورت 5432 (برای migrate / db push)
# DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-REGION.pooler.supabase.com:5432/postgres"

# ───────── تنظیمات اپ ─────────
# رمز ورود به پنل مدیریت (صفحه‌ی /admin/login)
ADMIN_PASSWORD="admin"

# کلید امضای کوکی سشن — یک رشته‌ی تصادفی بلند (حداقل ۳۲ کاراکتر).
# نمونه‌ی تولید:  openssl rand -base64 32
SESSION_SECRET="please-generate-a-long-random-secret-string"
