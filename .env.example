# دیتابیس — برای توسعه‌ی محلی از SQLite استفاده می‌کنیم.
# برای پروداکشن (مثلاً Vercel) این را به Postgres تغییر بده:
#   DATABASE_URL="postgresql://USER:PASS@HOST:5432/DBNAME"
# و در prisma/schema.prisma مقدار provider را به "postgresql" تغییر بده.
DATABASE_URL="file:./dev.db"

# رمز ورود به پنل مدیریت (هرچه می‌خواهی بگذار؛ همین رمز در صفحه‌ی /admin/login وارد می‌شود)
ADMIN_PASSWORD="admin"

# کلید امضای کوکی سشن — یک رشته‌ی تصادفی بلند (حداقل ۳۲ کاراکتر).
# نمونه‌ی تولید: openssl rand -base64 32
SESSION_SECRET="please-generate-a-long-random-secret-string"
