# ═════════════════════════════════════════════════════════════
#  الگوی متغیرهای محیطی. این فایل به گیت می‌رود (بدون رمز واقعی).
#  برای شروع، از رویش کپی بگیر:  cp .env.example .env
# ═════════════════════════════════════════════════════════════

# ───────── حالت ۱) توسعه‌ی لوکال (Postgres روی همین سیستم) ─────────
# یک Postgres لوکال بساز و دیتابیس barber را ایجاد کن، سپس:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barber"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/barber"

# ───────── حالت ۲) پروداکشن (PostgreSQL روی لیارا) ─────────
# 🔴 روی سرور، این مقادیر در پنلِ لیارا → برنامه → تنظیمات → متغیرهای محیطی ست می‌شوند،
#    نه در این فایل. این فایل فقط الگوست و رمزِ واقعی هرگز نباید داخلش نوشته شود.
#
# دیتابیسِ لیارا اتصالِ مستقیم دارد، پس هر دو متغیر یک مقدار می‌گیرند
# (برخلاف Supabase که اتصالِ Pooled و Direct را جدا می‌کرد).
# DATABASE_URL="postgresql://root:[PASSWORD]@[DB-HOST]:[PORT]/postgres"
# DIRECT_URL="postgresql://root:[PASSWORD]@[DB-HOST]:[PORT]/postgres"

# ───────── تنظیمات اپ ─────────
# تایم‌زونِ سرور. روی لیارا از طریقِ liara.json هم ست می‌شود؛ این متغیر یک ضمانتِ دوم است
# تا اگر آن تنظیم به هر دلیل اعمال نشد، ساعتِ سرور باز هم تهران بماند.
#
# ⚠️ تاریخ و ساعتِ *نوبت‌ها* به این متغیر وابسته نیست — آن‌ها همه‌جا صریحاً «به وقتِ تهران»
#    حساب می‌شوند و با هر تایم‌زونی درست کار می‌کنند. این متغیر فقط روی چیزهای جانبی
#    اثر دارد: زمانِ نوشته‌شده در لاگ‌های سرور، سالِ کپی‌رایتِ فوتر، و ساعتِ اجرای کرون.
TZ="Asia/Tehran"
# رمز ورود به پنل مدیریت (صفحه‌ی /admin/login).
# 🔴 حتماً یک رمزِ قوی (حداقل ۸ کاراکتر) بگذار؛ رمزهای ضعیف/پیش‌فرض (مثل admin) رد می‌شوند.
ADMIN_PASSWORD=""

# کلید امضای کوکی سشن — یک رشته‌ی تصادفی بلند (حداقل ۳۲ کاراکتر).
# نمونه‌ی تولید:  openssl rand -base64 32
SESSION_SECRET="please-generate-a-long-random-secret-string"

# ───────── درگاه پرداخت زرین‌پال ─────────
# شناسه‌ی پذیرنده (Merchant ID) که از پنل زرین‌پال می‌گیری (فرمت UUID).
ZARINPAL_MERCHANT_ID=""
# تا قبل از دریافت مرچنت واقعی، روی حالت تستی (sandbox) بگذار: "true"
ZARINPAL_SANDBOX="true"
# توکن دسترسیِ استرداد (متفاوت با merchant_id). بدون آن، استرداد فقط «حسابداری» ثبت می‌شود.
ZARINPAL_ACCESS_TOKEN=""
# ⏸️ کلیدِ روشن/خاموشِ استردادِ وجه هنگامِ لغو نوبت.
#    "false" = لغو فقط لغو می‌کند؛ نه تماسی با زرین‌پال، نه برچسبِ «مسترد شده».
#    برای روشن‌کردن: این را "true" کن و ZARINPAL_ACCESS_TOKEN را هم پر کن.
NEXT_PUBLIC_REFUNDS_ENABLED="false"
# 🔴 اجازه‌ی «پرداختِ شبیه‌سازی‌شده» بدونِ درگاهِ واقعی. فقط برای توسعه/تست روی "true".
#    اگر MERCHANT_ID خالی باشد و این هم "true" نباشد، هر پرداخت با خطا رد می‌شود (امن).
#    روی پروداکشن هرگز "true" نگذار.
ALLOW_MOCK_PAYMENT="true"
# 🔴 آدرس پایه‌ی سایت. روی سرور *اجباری* است: هم برای بازگشت از درگاه بانک و هم برای
# درست‌بودنِ sitemap و آدرسِ متعارف. آدرسِ کاملِ دامنه، بدونِ اسلشِ انتهایی.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ───────── موتورهای جست‌وجو ─────────
# 🔍 اجازه‌ی فهرست‌شدنِ سایت در گوگل و بقیه‌ی موتورهای جست‌وجو.
#    "false" (پیش‌فرض) = سایت از دیدِ گوگل کاملاً بسته است — هم در robots.txt و هم با
#    برچسبِ داخلِ صفحه‌ها. مناسبِ دوره‌ای که درگاهِ پرداخت هنوز تستی است، چون هر کسی که
#    سایت را پیدا کند می‌تواند بدونِ پرداختِ واقعی نوبت بگیرد.
#
# 🔴 روزِ افتتاحِ واقعی این را "true" کن و دوباره دیپلوی کن — همان لحظه‌ای که
#    ZARINPAL_SANDBOX را false می‌کنی. اگر فراموش کنی، سایت برای همیشه از گوگل پنهان
#    می‌ماند و هیچ خطایی هم نمی‌بینی.
#    (راهِ تشخیص: آدرسِ /robots.txt را باز کن؛ «Disallow: /» یعنی هنوز بسته است.)
NEXT_PUBLIC_INDEXING_ENABLED="false"

# ───────── سامانه‌ی پیامک (SMS/OTP) ─────────
# ⏸️ کلیدِ اصلیِ روشن/خاموشِ همه‌ی کارهای پیامکی: کدِ تأییدِ لغو نوبت (و در نتیجه لغوِ
#    آنلاین توسط مشتری) + پیامکِ یادآوریِ نوبت. رزرو و پرداخت به این کلید ربطی ندارند.
#    "false" = تا وقتی پنلِ پیامک نداری. بعد از خریدِ پنل "true" کن و دوباره بیلد بگیر.
NEXT_PUBLIC_SMS_ENABLED="false"
# انتخابِ provider: console (فقط لاگ، توسعه) | kavenegar (نمونه‌ی آماده) | custom (قلابِ خودت)
SMS_PROVIDER="console"
# کلیدِ APIِ پنلِ پیامک (وقتی provider واقعی شد).
SMS_API_KEY=""
# شماره/خطِ ارسال (اگر پنل نیاز دارد).
SMS_SENDER=""
# نامِ قالب/الگوی OTP در پنل (پنل‌های ایرانی معمولاً برای کدِ تأیید «لوکاپ/الگو» دارند).
SMS_OTP_TEMPLATE=""

# ───────── کرون (پاک‌سازیِ رزروهای رهاشده) ─────────
# رشته‌ی تصادفیِ بلند. روی سرور ست کن تا فقط کرونِ خودِ هاست بتواند
# /api/cron/expire-pending را صدا بزند (رجوع به آرایه‌ی cron در liara.json).  نمونه‌ی تولید:  openssl rand -base64 32
CRON_SECRET=""
