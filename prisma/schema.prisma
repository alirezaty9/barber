// پروداکشن: دیتابیس PostgreSQL روی لیارا.
// DATABASE_URL = اتصالِ زمانِ اجرا.
// DIRECT_URL   = اتصالی که فقط برای `db push` و `db execute` استفاده می‌شود.
// روی لیارا هر دو یک مقدارِ یکسان می‌گیرند؛ دو متغیرِ جدا فقط برای هاست‌هایی لازم است
// که اتصالِ زمانِ اجرا را از یک واسطه (connection pooler) رد می‌کنند.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Service {
  id          String    @id @default(cuid())
  name        String
  price       Int
  duration    Int // به دقیقه
  description String    @default("")
  category    String    @default("hair") // hair | beard | grooming | combo
  // تصویرِ اختصاصیِ خدمت: data URL (آپلودِ ادمین) یا آدرس. خالی = از روی دسته‌بندی.
  image       String    @default("")
  createdAt   DateTime  @default(now())
  // یک خدمت می‌تواند خدمتِ اصلی یا خدمتِ دومِ چند نوبت باشد (هر نوبت تا دو خدمت).
  bookings    Booking[] @relation("PrimaryService")
  bookings2   Booking[] @relation("SecondService")
}

model Barber {
  id        String    @id @default(cuid())
  name      String
  specialty String    @default("")
  avatar    String    @default("")
  rating    Float     @default(5)
  bio       String    @default("")
  image     String    @default("")
  // روزهای کاری به‌صورت CSV از 0..6 (0=شنبه ... 6=جمعه) — SQLite آرایه ندارد.
  workDays  String    @default("0,1,2,3,4,5,6")
  createdAt DateTime  @default(now())
  bookings  Booking[]
  blocks    BarberBlock[]
}

// بستن زمان (مرخصی/تعطیلی): کل روز (timeSlot = null) یا یک ساعتِ مشخص.
model BarberBlock {
  id        String   @id @default(cuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  timeSlot  String? // null = کل روز؛ در غیر این صورت ساعتِ مشخص (HH:MM)
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([barberId, date])
}

model Booking {
  id            String   @id @default(cuid())
  code          String   @unique // کد رهگیری برای مشتری
  customerName  String
  customerPhone String
  // در صورت حذف خدمت/آرایشگر، نوبت تاریخی حذف نشود؛ فقط مرجع null می‌شود.
  serviceId     String?
  service       Service? @relation("PrimaryService", fields: [serviceId], references: [id], onDelete: SetNull)
  // خدمت دومِ اختیاری (برای سازگاری با رکوردهای قدیمی؛ نمایشِ چند-خدمتی از servicesLabel است).
  serviceId2    String?
  service2      Service? @relation("SecondService", fields: [serviceId2], references: [id], onDelete: SetNull)
  // برچسبِ کاملِ خدمات (چند خدمت با ' + ') — اسنپ‌شات هنگام رزرو برای نمایش.
  servicesLabel String   @default("")
  barberId      String?
  barber        Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)
  date          String // YYYY-MM-DD (میلادی؛ نمایش به کاربر جلالی است)
  timeSlot      String // HH:MM
  status        String   @default("pending") // pending | confirmed | cancelled
  // فیلدهای پرداخت آنلاین (زرین‌پال)
  amount           Int     @default(0)        // مبلغ کل (تومان) اسنپ‌شات هنگام رزرو
  paymentStatus    String  @default("unpaid") // unpaid | paid | failed | refunded
  paymentAuthority String?                    // Authority زرین‌پال برای یافتن رزرو در callback
  paymentRefId     String?                    // کد پیگیری زرین‌پال بعد از verify موفق
  // استرداد در صورت لغو: مشتری ۵۰٪ برمی‌گردد، آرایشگر(ادمین) ۱۰۰٪.
  cancelledBy      String?                    // customer | admin — لغوکننده
  refundAmount     Int     @default(0)        // مبلغ مستردشده (تومان)
  // کدِ تأییدِ دومرحله‌ایِ لغو (توسط مشتری). خودِ کد هرگز ذخیره نمی‌شود؛ فقط hashِ آن.
  cancelOtpHash      String?
  cancelOtpExpiresAt DateTime?
  cancelOtpAttempts  Int     @default(0)
  // یادآوریِ ۲ ساعت قبل از نوبت: زمانِ ارسالِ پیامکِ یادآوری. null یعنی هنوز نرفته —
  // برای جلوگیری از ارسالِ تکراری (هر نوبت فقط یک‌بار یادآوری می‌شود).
  reminderSentAt DateTime?
  createdAt     DateTime @default(now())

  @@index([barberId, date])
  // ایندکس‌های فهرست/جست‌وجوی ادمین: فیلترِ تاریخ + مرتب‌سازیِ [date,timeSlot] و فیلترِ وضعیت.
  @@index([date, timeSlot])
  @@index([status])
  // ⚠️ یکتایی واقعیِ اسلات (ضدِ double-booking) یک «partial unique index» است که Prisma در
  // schema پشتیبانی نمی‌کند؛ آن را با SQL جدا اعمال کن: prisma/sql/uniq-active-slot.sql
}

